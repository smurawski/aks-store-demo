{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "rgName": {
      "value": "${AZURE_RESOURCE_GROUP}"
    },
    "appEnvironment": {
      "value": "aitour"
    },
    "location": {
      "value": "eastus2"
    },
    "aksNodePoolVMSize": {
      "value": "${AKS_NODE_POOL_VM_SIZE}"
    },
    "deployAzureContainerRegistry": {
      "value": "false"
    },
    "deployAzureServiceBus": {
      "value": "true"
    },
    "deployObservabilityTools": {
      "value": "false"
    },
    "deployAzureCosmosDB": {
      "value": "true"
    },
    "cosmosDBAccountKind": {
      "value": "MongoDB"
    },
    "deployAzureOpenAI": {
      "value": "true"
    },
    "azureOpenAILocation": {
      "value": "swedencentral"
    },
    "deployImageGenerationModel": {
      "value": "false"
    },
    "source_registry": {
      "value": "ghcr.io/smurawski/aks-store-demo"
    }
  }
}